<% content_for(:title, t('good_deed.all.title')) %>
<div class="container pt-3">
  <div class="row">
    <div class="col-12">
      <div class="row">
        <%# ポイントは一覧の有無と無関係に出す（範囲外のページでも消えないように） %>
        <%= render "good_deeds/points_summary",
              total_label: t('good_deed.all.total_points'),
              total_points: @total_points,
              today_label: t('good_deed.all.today_points'),
              today_points: @today_points,
              today_empty_message: t('good_deed.all.today_empty') %>

        <% if @good_deeds.present? %>
          <% @good_deeds.each do |deed| %>
            <%= render layout: "good_deeds/deed_card", locals: { deed: deed, show_author: true } do %>
              <%= render "likes/like_button", deed: deed, user_likes: @user_likes %>
            <% end %>
          <% end %>

          <div class="d-flex justify-content-center mt-3">
            <%= paginate @good_deeds %>
          </div>
        <% else %>
          <div class="mb-3"><%= t('good_deed.all.empty') %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
