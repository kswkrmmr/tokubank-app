<% content_for(:title, "みんなの徳") %>
<div class="container pt-3">
  <div class="row">
    <div class="col-12">
      <div class="row">
        <% if @good_deeds.present? %>
          <%= render "good_deeds/points_summary",
                total_label: "みんなの合計徳ポイント",
                total_points: @total_points,
                today_label: "今日のみんなの徳ポイント",
                today_points: @today_points,
                today_empty_message: "今日はまだ誰も徳を積んでいません" %>

          <% @good_deeds.each do |deed| %>
            <%= render layout: "good_deeds/deed_card", locals: { deed: deed, show_author: true } do %>
              <%= render "likes/like_button", deed: deed, user_likes: @user_likes %>
            <% end %>
          <% end %>

          <div class="d-flex justify-content-center mt-3">
            <%= paginate @good_deeds %>
          </div>
        <% else %>
          <div class="mb-3">まだ誰も徳を積んでいないようです</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
