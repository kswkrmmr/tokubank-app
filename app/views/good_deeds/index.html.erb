<% content_for(:title, t('good_deed.index.title')) %>
<div class="container pt-3">
  <div class="row">
    <div class="col-12">
      <div class="row">
        <%# ポイントは一覧の有無と無関係に出す（範囲外のページでも消えないように） %>
        <%= render "good_deeds/points_summary",
              available_label: t('good_deed.index.available_points'),
              available_points: @available_points,
              total_label: t('good_deed.index.total_points'),
              total_points: @total_points,
              today_label: t('good_deed.index.today_points'),
              today_points: @today_points,
              today_empty_message: t('good_deed.index.today_empty') %>

        <% if @good_deeds.present? %>
          <% @good_deeds.each do |deed| %>
            <%= render layout: "good_deeds/deed_card", locals: { deed: deed, show_author: false } do %>
              <%= button_to t('good_deed.index.delete'), good_deed_path(deed), method: :delete,
                data: { turbo_confirm: t('defaults.delete_confirm') },
                class: "btn btn-danger btn-sm" %>
            <% end %>
          <% end %>

          <div class="d-flex justify-content-center mt-3">
            <%= paginate @good_deeds %>
          </div>
        <% else %>
          <div class="mb-3"><%= t('good_deed.index.empty') %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
