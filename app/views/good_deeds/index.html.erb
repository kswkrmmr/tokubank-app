<% content_for(:title, t('good_deed.index.title')) %>
<div class="container pt-3">
  <div class="row">
    <div class="col-12">
      <div class="row">
        <% if @good_deeds.present? %>
          <%= render "good_deeds/points_summary",
                total_label: "合計徳ポイント",
                total_points: @total_points,
                today_label: "今日の徳ポイント",
                today_points: @today_points,
                today_empty_message: "今日はまだ徳を積んでいません" %>

          <% @good_deeds.each do |deed| %>
            <%= render layout: "good_deeds/deed_card", locals: { deed: deed, show_author: false } do %>
              <%= button_to "削除", good_deed_path(deed), method: :delete,
                data: { turbo_confirm: "削除しますか？" },
                class: "btn btn-danger btn-sm" %>
            <% end %>
          <% end %>

          <div class="d-flex justify-content-center mt-3">
            <%= paginate @good_deeds %>
          </div>
        <% else %>
          <div class="mb-3">まだ徳を積んでいないようです</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
