<div class="row text-center mb-4">
  <div class="col">
    <div class="card shadow-sm p-3">
      <h5><%= total_label %></h5>
      <h2 class="text-success"><%= total_points %> pt</h2>
    </div>
  </div>

  <div class="col">
    <div class="card shadow-sm p-3">
      <h5><%= today_label %></h5>
      <% if today_points > 0 %>
        <h2 class="text-success"><%= today_points %> pt</h2>
      <% else %>
        <p class="text-muted"><%= today_empty_message %></p>
      <% end %>
    </div>
  </div>
</div>
