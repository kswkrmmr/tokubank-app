<% content_for(:title, t('reward.index.title')) %>
<div class="container pt-3">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-end mb-3">
        <%= link_to t('reward.index.new'), new_reward_path, class: "btn btn-success" %>
      </div>

      <h2 class="h5 mb-3"><%= t('reward.index.pending') %></h2>
      <% if @pending_rewards.present? %>
        <% @pending_rewards.each do |reward| %>
          <div class="card mb-3 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
              <div>
                <strong><%= reward.name %></strong>
                <span class="text-success ms-2"><%= reward.cost %> pt</span>
              </div>
              <%= button_to t('reward.index.delete'), reward_path(reward), method: :delete,
                data: { turbo_confirm: t('defaults.delete_confirm') },
                class: "btn btn-outline-danger btn-sm" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="mb-4 text-muted"><%= t('reward.index.pending_empty') %></div>
      <% end %>

      <h2 class="h5 mt-4 mb-3"><%= t('reward.index.redeemed') %></h2>
      <% if @redeemed_rewards.present? %>
        <% @redeemed_rewards.each do |reward| %>
          <div class="card mb-3 shadow-sm bg-light">
            <div class="card-body d-flex justify-content-between align-items-center">
              <div>
                <strong><%= reward.name %></strong>
                <span class="text-muted ms-2"><%= reward.cost %> pt</span>
              </div>
              <span class="text-muted small">
                <%= t('reward.index.redeemed_on', date: l(reward.redeemed_at.to_date)) %>
              </span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-muted"><%= t('reward.index.redeemed_empty') %></div>
      <% end %>
    </div>
  </div>
</div>
