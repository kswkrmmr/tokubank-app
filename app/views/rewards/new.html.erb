<% content_for(:title, t('reward.new.title')) %>
<%= render partial: 'shared/error_messages', locals: { object: @reward } %>
<div class="container py-5">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <h1 class="h4 mb-4"><%= t('reward.new.title') %></h1>

      <%= form_with model: @reward do |f| %>
        <div class="mb-3">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :cost, class: "form-label" %>
          <%= f.number_field :cost, class: "form-control" %>
        </div>

        <div class="text-center">
          <%= f.submit t('helpers.submit.create'), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
