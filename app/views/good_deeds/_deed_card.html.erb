<%# 操作ボタン（削除 / いいね）は呼び出し側からブロックで渡す %>
<div class="card mb-3 shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between">
      <strong><%= deed.content %></strong>
      <span class="text-success"><%= deed.points %> pt</span>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
      <div>
        <span class="text-muted small"><%= deed.performed_on %></span>
        <% if show_author %>
          <span class="text-muted small ms-2">by <%= deed.user.name %></span>
        <% end %>
      </div>
      <%= yield %>
    </div>
  </div>
</div>
