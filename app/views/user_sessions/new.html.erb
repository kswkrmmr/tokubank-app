<% content_for(:title, t('user_sessions.new.title')) %>
<div class="container py-5">
  <div class="row">
    <div class="col-md-8 col-lg-5 mx-auto">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h1 class="card-title h4 mb-4 text-center"><%= t('user_sessions.new.title') %></h1>
          <%= form_with url: login_path do |f| %>
            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, class: "form-control", autocomplete: "username" %>
            </div>
            <div class="mb-3">
              <%= f.label :password, class: "form-label" %>
              <%= f.password_field :password, class: "form-control", autocomplete: "current-password" %>
            </div>
            <div class="d-grid mb-3">
              <%= f.submit t('user_sessions.new.login'), class: "btn btn-success" %>
            </div>
          <% end %>
          <div class="text-center">
            <%= link_to t('user_sessions.new.to_register_page'), new_user_path %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>